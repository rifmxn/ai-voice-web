# ================================================================
# Konfigurasi Telegram AI Agent (.env)
# ================================================================

# Token Bot Telegram yang diperoleh daripada @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Kunci API Gemini yang diperoleh daripada Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (Pilihan: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-4-hydrogen)
# Default adalah gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Laluan fail pangkalan data SQLite (Pilihan, default: bot_memory.db)
DATABASE_PATH=bot_memory.db
